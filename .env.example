# Copy to .env (gitignored) and adjust. Every variable has a safe default,
# so the API also starts with no .env at all. There are no secrets here:
# the service is read-only and talks to nothing.

# Deployment environment label, shown in logs and /api/v1/meta (dev | staging | prod)
APP_ENV=dev

# Log verbosity (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Folder holding the exported game data JSON files (relative to the working directory)
DATA_DIR=data

# Git commit the running build came from. CI and the Docker build set this automatically.
GIT_SHA=unknown

# Port the API container publishes on the host (docker compose only)
API_PORT=8000

# Grafana admin login for the local stack only. Change it before exposing Grafana anywhere.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-locally
