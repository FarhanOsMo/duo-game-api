root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml,md,lua}]
indent_size = 2

[*.ps1]
end_of_line = crlf

[Makefile]
indent_style = tab

# data/ is exported by the game and must never be reformatted by an editor.
[data/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
